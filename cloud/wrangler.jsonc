{
  "name": "voice-canvas",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "../docs",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/worlds/*"
    ]
  },
  "vars": {
    "MODEL": "glm-4.7-flash"
  },
  "ratelimits": [
    {
      "name": "MODEL_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
